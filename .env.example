# Required for the chat assistant. Everything else works without it.
ANTHROPIC_API_KEY=
# Optional
PORT=3000
COMPANY_NAME=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Where the SQLite file lives (put it on a persistent disk when hosted)
DB_PATH=./data/sales-desk.db
# Password for the demo logins created on first run. Change before inviting the team.
SEED_PASSWORD=demo1234
NODE_ENV=production
